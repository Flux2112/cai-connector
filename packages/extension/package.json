{
  "name": "cai-connector",
  "displayName": "CAI Connector",
  "description": "Create and connect to Cloudera AI sessions over SSH.",
  "version": "1.22.0",
  "publisher": "DefySoftwareSolutions",
  "repository": {
    "type": "git",
    "url": "https://github.com/Flux2112/cai-connector.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "cai-connector.png",
  "license": "GPL-3.0-or-later",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cai-connector-sidebar",
          "title": "CAI Connector",
          "icon": "media/cai-sidebar.svg"
        }
      ]
    },
    "views": {
      "cai-connector-sidebar": [
        {
          "id": "caiConnector.sessionsView",
          "name": "Sessions"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "caiConnector.connect",
          "when": "view == caiConnector.sessionsView",
          "group": "navigation"
        },
        {
          "command": "caiConnector.refreshSessions",
          "when": "view == caiConnector.sessionsView",
          "group": "navigation"
        },
        {
          "command": "caiConnector.cleanUpOrphans",
          "when": "view == caiConnector.sessionsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "caiConnector.joinSession",
          "when": "view == caiConnector.sessionsView && viewItem == activeSession",
          "group": "inline"
        },
        {
          "command": "caiConnector.recreateSession",
          "when": "view == caiConnector.sessionsView && viewItem =~ /^(active|inactive|orphan)Session$/",
          "group": "inline"
        },
        {
          "command": "caiConnector.editSession",
          "when": "view == caiConnector.sessionsView && viewItem =~ /^(active|inactive|orphan)Session$/",
          "group": "inline"
        },
        {
          "command": "caiConnector.killSession",
          "when": "view == caiConnector.sessionsView && viewItem =~ /^(active|orphan)Session$/",
          "group": "inline"
        },
        {
          "command": "caiConnector.removeSession",
          "when": "view == caiConnector.sessionsView && viewItem == inactiveSession",
          "group": "inline"
        }
      ]
    },
    "commands": [
      {
        "command": "caiConnector.connect",
        "title": "Connect",
        "category": "CAI Connector",
        "icon": "$(add)"
      },
      {
        "command": "caiConnector.disconnect",
        "title": "Disconnect Sessions",
        "category": "CAI Connector"
      },
      {
        "command": "caiConnector.cleanUpOrphans",
        "title": "Clean Up Orphaned Sessions",
        "category": "CAI Connector",
        "icon": "$(clear-all)"
      },
      {
        "command": "caiConnector.browseRuntimes",
        "title": "Browse Runtimes",
        "category": "CAI Connector"
      },
      {
        "command": "caiConnector.clearCache",
        "title": "Clear Runtime Cache",
        "category": "CAI Connector"
      },
      {
        "command": "caiConnector.resetApiKey",
        "title": "Reset API Key",
        "category": "CAI Connector"
      },
      {
        "command": "caiConnector.reconnect",
        "title": "Recreate Last Session",
        "category": "CAI Connector"
      },
      {
        "command": "caiConnector.refreshSessions",
        "title": "Refresh Sessions",
        "category": "CAI Connector",
        "icon": "$(refresh)"
      },
      {
        "command": "caiConnector.joinSession",
        "title": "Join Session",
        "category": "CAI Connector",
        "icon": "$(plug)"
      },
      {
        "command": "caiConnector.recreateSession",
        "title": "Recreate Session",
        "category": "CAI Connector",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "caiConnector.killSession",
        "title": "Kill Session",
        "category": "CAI Connector",
        "icon": "$(debug-stop)"
      },
      {
        "command": "caiConnector.editSession",
        "title": "Edit Session Configuration",
        "category": "CAI Connector",
        "icon": "$(edit)"
      },
      {
        "command": "caiConnector.removeSession",
        "title": "Remove Session Entry",
        "category": "CAI Connector",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "CAI Connector",
      "properties": {
        "caiConnector.cmlUrl": {
          "type": "string",
          "default": "",
          "description": "Cloudera AI (CML) base URL."
        },
        "caiConnector.cdswctlPath": {
          "type": "string",
          "default": "",
          "description": "Full path to cdswctl.exe. When empty, the extension looks for cdswctl.exe on PATH."
        },
        "caiConnector.defaultCpus": {
          "type": "number",
          "default": 0.5,
          "exclusiveMinimum": 0,
          "description": "Default CPU count. Fractional values are allowed when your platform deploys fractional CPU profiles, for example 0.5."
        },
        "caiConnector.defaultMemoryGb": {
          "type": "number",
          "default": 16,
          "exclusiveMinimum": 0,
          "description": "Default memory in GB. Fractional values are allowed, for example 0.5."
        },
        "caiConnector.cpuProfiles": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "default": [
            0.5,
            1,
            2,
            4,
            8
          ],
          "description": "CPU profile sizes offered as one-click choices in the session form. Set this to the profiles your platform actually deploys. Values outside this list are still accepted, with a warning."
        },
        "caiConnector.memoryProfiles": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "default": [
            2,
            4,
            8,
            16,
            32
          ],
          "description": "Memory sizes in GB offered as one-click choices in the session form."
        },
        "caiConnector.defaultGpus": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Default number of GPUs."
        },
        "caiConnector.cacheHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "Runtime cache duration in hours."
        },
        "caiConnector.latestRuntimesOnly": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, only the latest version of each runtime (grouped by editor, kernel, and edition) is shown in the runtime picker."
        },
        "caiConnector.autoStopOrphanedSessions": {
          "type": "boolean",
          "default": true,
          "description": "Stop CML sessions this extension created once their local SSH endpoint is gone. Only sessions recorded in the extension's own history are ever stopped, and only ones CML confirms are still running. Disable this to clean up manually with 'Clean Up Orphaned Sessions'."
        },
        "caiConnector.openInSameWindow": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, the remote SSH session opens in the current window instead of a new window."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.4.5"
  }
}
